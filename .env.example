# =============================================================
# agent-automation — Variables de entorno
# Copia este archivo a .env y rellena los valores reales.
# NUNCA commitees .env al repositorio.
# =============================================================

# --- APIs de IA ---
ANTHROPIC_API_KEY=sk-ant-...
OPENAI_API_KEY=sk-...           # Opcional: solo si usas GPT
GOOGLE_AI_API_KEY=              # Opcional: solo si usas Gemini

# --- Telegram ---
TELEGRAM_BOT_TOKEN=             # Token del bot (BotFather)
TELEGRAM_CHAT_ID=               # Tu chat ID personal (usa @userinfobot para obtenerlo)

# --- GitHub ---
GITHUB_TOKEN=ghp_...            # Personal Access Token con permisos: repo, pull_requests

# --- Base de datos ---
# Desarrollo: SQLite (sin configuración extra)
DATABASE_URL=sqlite:///./dev.db
# Producción (Railway): descomentar y configurar
# DATABASE_URL=postgresql://user:password@host:5432/agentdb

# --- Redis ---
REDIS_URL=redis://localhost:6379/0
# Railway: usa la URL interna del servicio Redis

# --- Sistema ---
SECRET_KEY=cambia-esto-por-algo-seguro-y-largo
ENVIRONMENT=development         # development | production
LOG_LEVEL=INFO

# --- Agentes ---
DEFAULT_AGENT=claude-opus-4     # Agente por defecto para tareas complejas
FAST_AGENT=claude-sonnet-4      # Agente para tareas simples / rápidas
MAX_CONCURRENT_AGENTS=3         # Máximo de agentes corriendo en paralelo

# --- Workspace de repos ---
# Directorio donde los agentes clonan los repositorios localmente
WORKSPACE_DIR=/workspace/repos
